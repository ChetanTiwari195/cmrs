# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true
# Comma-separated hostnames this API is served on
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated frontend origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Neon connection string (Neon dashboard -> Connect)
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Password used by `manage.py seed_demo` for all demo users
DEMO_PASSWORD=Demo@12345
